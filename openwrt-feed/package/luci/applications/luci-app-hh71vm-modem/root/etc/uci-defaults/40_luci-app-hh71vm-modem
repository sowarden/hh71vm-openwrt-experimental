#!/bin/sh
# rpcd kills a plugin call that outlives its timeout and answers "No response".  The
# hard ceiling on a LuCI RPC is not here, though: /admin/ubus calls libubus with its
# default 30 s, so anything slower than that has to be a job that is polled (the
# operator scan is one).  rpcd only needs enough headroom that it never kills a call
# the browser is still waiting for.
uci -q batch <<-EOT
	set rpcd.@rpcd[0].timeout=60
	commit rpcd
EOT
/etc/init.d/rpcd reload >/dev/null 2>&1
exit 0
