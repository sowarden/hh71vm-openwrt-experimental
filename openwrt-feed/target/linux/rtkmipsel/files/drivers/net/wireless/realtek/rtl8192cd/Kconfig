#
# Wireless LAN device configuration
#
config RTL8192CD
	tristate "RTL8192C/D 802.11b/g/n support"
	select WIRELESS_EXT
##########################################################################
# Select the interface WiFi device connects to
##########################################################################
config WIFI_HCI
	bool
	default y

config PCI_HCI
	bool
	depends on WIFI_HCI && (USE_PCIE_SLOT_0 || USE_PCIE_SLOT_1 || SOC_WIFI)
	default y

