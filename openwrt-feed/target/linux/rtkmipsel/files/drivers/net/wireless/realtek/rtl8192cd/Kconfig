	config SOC_RFE_TYPE_3
	depends on WLAN_HAL_8198F
	bool "Type 3: external PA/LNA (_K)"
	select SOC_EXT_PA
	select SOC_EXT_LNA

	config SOC_RFE_TYPE_4
	depends on WLAN_HAL_8197F
