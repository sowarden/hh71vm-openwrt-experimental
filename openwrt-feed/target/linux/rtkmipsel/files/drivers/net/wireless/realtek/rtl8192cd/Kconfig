	default y

choice
	prompt "RFE Type"
	default SOC_RFE_TYPE_1
	depends on (WLAN_HAL_8197F || WLAN_HAL_8197G || WLAN_HAL_8198F)
	
	config SOC_RFE_TYPE_0
