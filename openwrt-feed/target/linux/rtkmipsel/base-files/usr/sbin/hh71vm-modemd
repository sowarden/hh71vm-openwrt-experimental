#!/usr/bin/lua
--[[
hh71vm-modemd -- modem control daemon for the Alcatel HH71VM.

The two halves of this router are separate Linux systems joined by USB/RNDIS.  All
modem logic lives on the Qualcomm half (192.168.225.1), whose AT interpreter sits on
/dev/smd7 and is reachable only from a shell there -- the vendor leaves telnet open
without a password, which is our way in.

Reading and writing cannot share one shell session (the modem's output would mix with
the shell's), so we hold two:

  reader  -- `exec cat /dev/smd7`, i.e. the socket becomes a raw modem read stream
  writer  -- an ordinary shell; commands go out as `printf '\101\124...' > /dev/smd7`
             with every byte octal-escaped, so no quoting or shell metacharacter can
             corrupt what the modem sees (proven on the device's busybox 1.20 printf).

Everything is driven from one nixio.poll loop: modem stream, control socket, timers.
Background polling keeps a parsed snapshot in memory and in a JSON file, so the web UI
reads instantly and never waits on the radio.  Requests from the UI arrive on a unix
socket (see /usr/libexec/rpcd/hh71vm-modem, which turns them into a ubus object).

Debug/one-shot use, no daemon needed:
    hh71vm-modemd --at 'AT+CSQ' 'AT+COPS?'
    hh71vm-modemd --call sms_list
    hh71vm-modemd --foreground -v
]]

local nixio = require "nixio"
local fs    = require "nixio.fs"
local json  = require "luci.jsonc"

local CFG = {
	host          = "192.168.225.1",
	port          = 23,
	dev           = "/dev/smd7",
	rundir        = "/var/run/hh71vm-modem",
	wan_if        = "eth2",
	fast_interval = 5,     -- signal/registration refresh, seconds
	slow_interval = 30,    -- operator, APN, SIM, SMS storage
	mode_interval = 30,    -- 2G/3G/4G selection, read over the kcap channel
	at_timeout    = 15,    -- default per-command deadline
	scan_timeout  = 180,   -- AT+COPS=? is slow by nature
	connect_wait  = 10,    -- TCP connect deadline
	sync_window   = 1.2,   -- discard shell noise for this long after `cat` starts
}

local STATUS_FILE = CFG.rundir .. "/status.json"
local CTL_SOCK    = CFG.rundir .. "/ctl.sock"

local EINPROGRESS = nixio.const.EINPROGRESS   -- 150 on MIPS, not the x86 115
local POLLIN      = nixio.poll_flags("in")
local POLLOUT     = nixio.poll_flags("out")
local POLLERR     = nixio.poll_flags("err", "hup")

local verbose = false

local function mono()
	local s, u = nixio.gettimeofday()
	return s + u / 1000000
end

local function log(fmt, ...)
	io.stderr:write(("[modemd] " .. fmt .. "\n"):format(...))
	io.stderr:flush()
end

local function dbg(fmt, ...)
	if verbose then log(fmt, ...) end
end

local function trim(s)
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

--=========================================================================== text

-- SMS bodies come back as UCS2 hex whenever the text is not plain Latin.
local function ucs2_to_utf8(hex)
	if #hex == 0 or #hex % 4 ~= 0 or hex:find("[^0-9A-Fa-f]") then return nil end
	local out, i = {}, 1
	while i <= #hex do
		local cp = tonumber(hex:sub(i, i + 3), 16)
		i = i + 4
		if cp >= 0xD800 and cp <= 0xDBFF and i + 3 <= #hex then   -- surrogate pair
			local lo = tonumber(hex:sub(i, i + 3), 16)
			if lo and lo >= 0xDC00 and lo <= 0xDFFF then
				cp = 0x10000 + (cp - 0xD800) * 0x400 + (lo - 0xDC00)
				i = i + 4
			end
		end
		if cp < 0x80 then
			out[#out + 1] = string.char(cp)
		elseif cp < 0x800 then
			out[#out + 1] = string.char(0xC0 + math.floor(cp / 0x40),
			                            0x80 + cp % 0x40)
		elseif cp < 0x10000 then
			out[#out + 1] = string.char(0xE0 + math.floor(cp / 0x1000),
			                            0x80 + math.floor(cp / 0x40) % 0x40,
			                            0x80 + cp % 0x40)
		else
			out[#out + 1] = string.char(0xF0 + math.floor(cp / 0x40000),
			                            0x80 + math.floor(cp / 0x1000) % 0x40,
			                            0x80 + math.floor(cp / 0x40) % 0x40,
			                            0x80 + cp % 0x40)
		end
	end
	return table.concat(out)
end

local function utf8_to_ucs2(str)
	local out, i = {}, 1
	while i <= #str do
		local c, cp, n = str:byte(i), nil, 0
		if c < 0x80 then cp, n = c, 0
		elseif c >= 0xF0 then cp, n = c - 0xF0, 3
		elseif c >= 0xE0 then cp, n = c - 0xE0, 2
		elseif c >= 0xC0 then cp, n = c - 0xC0, 1
		else cp, n = 0xFFFD, 0 end
		for k = 1, n do
			local cc = str:byte(i + k) or 0x80
			cp = cp * 0x40 + (cc - 0x80)
		end
		i = i + n + 1
		if cp < 0x10000 then
			out[#out + 1] = ("%04X"):format(cp)
		else                                            -- split into surrogates
			cp = cp - 0x10000
			out[#out + 1] = ("%04X%04X"):format(0xD800 + math.floor(cp / 0x400),
			                                    0xDC00 + cp % 0x400)
		end
	end
	return table.concat(out)
end

local function is_ascii(str)
	return not str:find("[\128-\255]")
end

-- The modem hands back UCS2 hex for non-Latin texts and plain text otherwise.
local function decode_body(s)
	s = trim(s)
	local dec = ucs2_to_utf8(s)
	return dec or s
end

--- An alphanumeric sender -- a brand name rather than a number -- comes back as its
--- character codes written in decimal and run together with no separator, so
--- "10810510210199101108108" means "lifecell".  The codes are GSM 7-bit, hence at most
--- 127: a leading 1 therefore always starts a three-digit code and anything else a
--- two-digit one, which makes the run unambiguous.  Only used when the type-of-address
--- says alphanumeric (bits 4-6 = 101), never on a real phone number.
local function decode_alpha_addr(s)
	if not s:match("^%d+$") then return nil end
	local out, i = {}, 1
	while i <= #s do
		local n = (s:sub(i, i) == "1") and 3 or 2
		if i + n - 1 > #s then return nil end
		local code = tonumber(s:sub(i, i + n - 1))
		if not code or code < 32 or code > 127 then return nil end
		out[#out + 1] = string.char(code)
		i = i + n
	end
	return table.concat(out)
end

--- <tooa>/<toda> as 3GPP 23.040 defines it; 0x50 in the type-of-number bits means the
--- address is text, not a number.
local function is_alpha_toa(toa)
	toa = tonumber(toa)
	return toa ~= nil and math.floor(toa / 16) % 8 == 5
end

local function decode_addr(addr, toa)
	addr = trim(addr)
	if is_alpha_toa(toa) then
		local a = decode_alpha_addr(addr)
		if a then return a end
	end
	return decode_body(addr)
end

--- "yy/MM/dd,hh:mm:ss+zz" -> seconds, for telling apart the segments of one long
--- message from two messages that merely arrived close together.
local function sms_ts_secs(ts)
	local y, mo, d, h, mi, s = tostring(ts):match("^(%d+)/(%d+)/(%d+),(%d+):(%d+):(%d+)")
	if not y then return nil end
	return os.time({ year = 2000 + tonumber(y), month = tonumber(mo), day = tonumber(d),
	                 hour = tonumber(h), min = tonumber(mi), sec = tonumber(s),
	                 isdst = false })
end

-- A segment filled to the brim is a segment with more to come: 67 characters in UCS2,
-- 153 in GSM 7-bit (both are the full payload minus the concatenation header).
local FULL_SEGMENT = { [67] = true, [153] = true, [152] = true, [66] = true }

--- Long messages arrive split, and text mode throws away the header that says so.
--- Same sender, seconds apart, previous segment full to the limit: that is one message.
local function group_segments(list)
	local out = {}
	for _, m in ipairs(list) do
		local prev = out[#out]
		local near = false
		if prev then
			local a, b = sms_ts_secs(prev.ts_last), sms_ts_secs(m.ts)
			near = (a and b) and math.abs(b - a) <= 90 or false
		end
		if prev and prev.open and near and prev.raw_sender == m.raw_sender
		   and #prev.indexes < 12 then
			prev.text = prev.text .. m.text
			prev.indexes[#prev.indexes + 1] = m.index
			prev.parts = prev.parts + 1
			prev.ts_last = m.ts
			prev.unread = prev.unread or m.unread
			prev.open = FULL_SEGMENT[m.len or -1] or false
		else
			m.indexes = { m.index }
			m.parts = 1
			m.ts_last = m.ts
			m.open = FULL_SEGMENT[m.len or -1] or false
			out[#out + 1] = m
		end
	end
	for _, m in ipairs(out) do
		m.open, m.ts_last, m.raw_sender, m.len = nil, nil, nil, nil
	end
	return out
end

--===================================================================== telnet I/O

local IAC, DONT, DO, WONT, WILL, SB, SE = 255, 254, 253, 252, 251, 250, 240

local Conn = {}
Conn.__index = Conn

function Conn.new(name)
	return setmetatable({ name = name, state = "down", rbuf = "", wbuf = "" }, Conn)
end

function Conn:start()
	self:close()
	self.sock = nixio.socket("inet", "stream")
	self.sock:setblocking(false)
	self.rbuf, self.wbuf = "", ""
	local ok, code = self.sock:connect(CFG.host, CFG.port)
	if ok then
		self.state = "up"
	elseif code == EINPROGRESS then
		self.state = "connecting"
	else
		self:close()
		return false, code
	end
	self.deadline = mono() + CFG.connect_wait
	return true
end

function Conn:close()
	if self.sock then pcall(function() self.sock:close() end) end
	self.sock, self.state, self.rbuf, self.wbuf = nil, "down", "", ""
end

-- Answer telnet option negotiation with a flat refusal and strip it from the stream.
function Conn:strip_iac(data)
	local out, reply, i = {}, {}, 1
	while i <= #data do
		local b = data:byte(i)
		if b == IAC and i < #data then
			local cmd = data:byte(i + 1)
			if (cmd == DO or cmd == DONT or cmd == WILL or cmd == WONT) and i + 2 <= #data then
				local opt = data:byte(i + 2)
				if cmd == DO then
					reply[#reply + 1] = string.char(IAC, WONT, opt)
				elseif cmd == WILL then
					reply[#reply + 1] = string.char(IAC, DONT, opt)
				end
				i = i + 3
			elseif cmd == SB then
				local j = data:find(string.char(IAC, SE), i, true)
				i = j and (j + 2) or (#data + 1)
			else
				i = i + 2
			end
		else
			out[#out + 1] = string.char(b)
			i = i + 1
		end
	end
	if #reply > 0 then self:send(table.concat(reply)) end
	return table.concat(out)
end

function Conn:send(data)
	self.wbuf = self.wbuf .. data
	self:flush()
end

function Conn:flush()
	if not self.sock or self.wbuf == "" then return end
	local n = self.sock:write(self.wbuf)
	if n then self.wbuf = self.wbuf:sub(n + 1) end
end

function Conn:recv()
	if not self.sock then return nil end
	local data, code = self.sock:read(4096)
	if data == nil then
		if code == nixio.const.EAGAIN then return "" end
		return nil                       -- error
	elseif data == "" then
		return nil                       -- peer closed
	end
	return self:strip_iac(data)
end

--=================================================== Qualcomm control channel (kcap)
-- The stock firmware does everything modem-related over TCP 2016 on the Qualcomm side,
-- and that channel carries the very same JSON-RPC its web UI speaks, wrapped in a
-- 44-byte binary header whose magic is "kcap".  Bare JSON gets no answer at all, which
-- is why the channel looked opaque for a long time.
--
-- We use it for the one thing AT cannot do on this modem -- picking 2G/3G/4G -- and
-- leave everything else on the AT port.  Frames:
--     0x00 4  "kcap"                0x1c 4  zero
--     0x04 4  total length          0x20 4  caller's context handle, echoed back
--     0x08 4  message number        0x24 4  reply: JSON length without the NUL
--     0x0c 4  1 = call, 2 = event   0x28 4  reply: 0x00000101
--     0x10 4  zero                  0x2c .. JSON, NUL terminated
--     0x14 4  0 in a call, 1 in a reply
--     0x18 4  zero
-- An event frame stops after 28 bytes and carries no JSON.

local KCAP = { host = "192.168.225.1", port = 2016, timeout = 6, seq = 0 }

function KCAP.le32(n)
	n = n % 4294967296
	return string.char(n % 256, math.floor(n / 256) % 256,
	                   math.floor(n / 65536) % 256, math.floor(n / 16777216) % 256)
end

function KCAP.rd32(s, pos)
	local a, b, c, d = s:byte(pos, pos + 3)
	if not d then return nil end
	return a + b * 256 + c * 65536 + d * 16777216
end

--- One call, one answer, one connection.  This runs a couple of times a minute at
--- most, so a persistent socket would only add a state machine to the poll loop and a
--- way to go stale while core_app restarts.
function KCAP.call(method, params, timeout)
	local deadline = mono() + (timeout or KCAP.timeout)
	local sock = nixio.socket("inet", "stream")
	sock:setblocking(false)

	local function fail(err)
		pcall(function() sock:close() end)
		dbg("kcap %s: %s", method, err)
		return nil, err
	end

	local ok, code = sock:connect(KCAP.host, KCAP.port)
	if not ok and code ~= EINPROGRESS then
		return fail("connect: " .. tostring(code))
	end
	if not ok then
		local ms = math.floor(math.max(0, deadline - mono()) * 1000)
		local cnt = nixio.poll({ { fd = sock, events = POLLOUT } }, ms)
		if not cnt or cnt < 1 then return fail("connect timed out") end
		local err = sock:getopt("socket", "error")
		if err ~= 0 then return fail("connect error " .. tostring(err)) end
	end

	KCAP.seq = (KCAP.seq % 65000) + 1
	local seq = KCAP.seq
	-- An empty Lua table has no type of its own, and an encoder is free to write it
	-- as [] -- core_app expects an object there, so spell the empty case out.
	local enc = (params and next(params) ~= nil) and json.stringify(params) or "{}"
	local body = '{"id": "12", "jsonrpc": "2.0", "method": "' .. method ..
	             '", "params": ' .. enc .. "}\0"
	local out = "kcap" .. KCAP.le32(44 + #body) .. KCAP.le32(seq) .. KCAP.le32(1)
	            .. KCAP.le32(0) .. KCAP.le32(0) .. KCAP.le32(0) .. KCAP.le32(0)
	            .. KCAP.le32(0x77000001) .. KCAP.le32(0) .. KCAP.le32(0) .. body
	while #out > 0 do
		if mono() > deadline then return fail("send timed out") end
		local cnt = nixio.poll({ { fd = sock, events = POLLOUT } }, 200)
		if cnt and cnt > 0 then
			local n = sock:write(out)
			if not n then return fail("write failed") end
			out = out:sub(n + 1)
		end
	end

	local buf = ""
	while true do
		while #buf >= 28 do
			if buf:sub(1, 4) ~= "kcap" then return fail("frame out of sync") end
			local total = KCAP.rd32(buf, 5)
			if not total or total < 28 or total > 262144 then
				return fail("bad frame length")
			end
			if #buf < total then break end
			local frame = buf:sub(1, total)
			buf = buf:sub(total + 1)
			-- A slow answer to an earlier call can still be on the wire, so match the
			-- message number: without that every call returns its neighbour's result.
			if total > 44 and KCAP.rd32(frame, 13) == 1
			   and KCAP.rd32(frame, 9) == seq then
				local text = frame:sub(45, total)
				text = text:gsub("%z+$", "")
				local msg = json.parse(text)
				if type(msg) ~= "table" then return fail("unparsable answer") end
				pcall(function() sock:close() end)
				if msg.error then
					return nil, (msg.error.message or
					             ("core_app error " .. tostring(msg.error.code)))
				end
				return msg.result or {}
			end
		end
		if mono() > deadline then return fail("no answer") end
		local cnt = nixio.poll({ { fd = sock, events = POLLIN } }, 200)
		if cnt and cnt > 0 then
			local data, err = sock:read(65536)
			if data == nil then
				if err ~= nixio.const.EAGAIN then return fail("read failed") end
			elseif data == "" then
				return fail("closed by core_app")
			else
				buf = buf .. data
			end
		end
	end
end

--====================================================================== AT engine

local M = {
	link    = { state = "down", since = 0, attempts = 0, last_ok = 0, error = "starting" },
	state   = {},                     -- parsed modem snapshot, published as JSON
	queue   = {},                     -- user requests (from the control socket)
	bg      = {},                     -- background poll requests
	cur     = nil,                    -- request in flight
	reader  = Conn.new("reader"),
	writer  = Conn.new("writer"),
	backoff = 1,
	next_try = 0,
	urc     = {},                     -- unsolicited results seen since last read
}

local function esc_printf(payload)
	-- every byte octal-escaped: the shell then cannot mangle anything
	return (payload:gsub(".", function(c) return ("\\%03o"):format(c:byte()) end))
end

function M.write_raw(payload)
	if M.writer.state ~= "up" then return false end
	M.writer:send(("printf '%s' > %s\n"):format(esc_printf(payload), CFG.dev))
	return true
end

--- Build a request.  steps = { {cmd=..., term="final"|"prompt", parse=fn, timeout=n}, }
local function request(name, steps, cb)
	return { name = name, steps = steps, idx = 0, lines = {}, cb = cb, raw = "" }
end

function M.enqueue(req, front)
	if front then table.insert(M.queue, 1, req) else M.queue[#M.queue + 1] = req end
end

local FINAL = {
	["OK"] = true, ["ERROR"] = true, ["NO CARRIER"] = true,
	["ABORTED"] = true, ["BUSY"] = true, ["NO ANSWER"] = true,
}

local function is_final(line)
	if FINAL[line] then return true end
	if line:match("^%+CME ERROR:") or line:match("^%+CMS ERROR:") then return true end
	return false
end

-- Codes that are always unsolicited, whatever else is going on.
local URC_ALWAYS = {
	["+CMTI"] = true, ["+CMT"] = true, ["+CUSD"] = true,
	["+CDS"] = true, ["+CBM"] = true, ["+CGEV"] = true,
}

-- Codes that exist in both roles: "+CEREG: 1" arrives on its own when registration
-- changes, but "+CEREG: 2,1,..." is the answer to AT+CEREG?.  Only context tells them
-- apart, so ask what we are waiting for.  (Treating the answer as unsolicited is what
-- kept registration state empty before.)
local URC_MAYBE = { ["+CREG"] = true, ["+CEREG"] = true, ["+CGREG"] = true }

local function is_urc(line)
	local tag = line:match("^([%+%$]%a+)")
	if not tag then return false end
	if URC_ALWAYS[tag] then return true end
	if not URC_MAYBE[tag] then return false end
	local r = M.cur
	local s = r and r.steps[r.idx]
	if s and s.cmd:upper():find(tag:upper(), 1, true) then return false end
	return true
end

function M.step_send()
	local r = M.cur
	r.idx = r.idx + 1
	local s = r.steps[r.idx]
	if not s then
		M.finish(true)
		return
	end
	r.lines = {}
	r.raw = ""
	r.deadline = mono() + (s.timeout or CFG.at_timeout)
	local payload = s.cmd
	if s.term ~= "raw_bytes" then payload = payload .. "\r" end
	dbg("-> %s", (s.cmd:gsub("[\r\n\26]", "?")))
	if not M.write_raw(payload) then
		M.finish(false, "channel down")
	end
end

function M.finish(ok, err)
	local r = M.cur
	M.cur = nil
	if ok then M.timeouts = 0 end
	if not r then return end
	if r.cb then
		local good, e = pcall(r.cb, ok, r.result or {}, err)
		if not good then log("callback %s failed: %s", r.name, tostring(e)) end
	end
end

function M.start_next()
	if M.cur or M.link.state ~= "ready" then return end
	local r = table.remove(M.queue, 1)
	if not r then return end
	M.cur = r
	r.result = {}
	M.step_send()
end

--- Feed one line of modem output into the state machine.
function M.on_line(line)
	line = line:gsub("\r", "")
	if line == "" then return end
	M.link.last_ok = mono()

	if is_urc(line) then
		dbg("<~ URC %s", line)
		M.on_urc(line)
		return
	end
	dbg("<- %s", line)

	local r = M.cur
	if not r then return end                     -- late output, no owner
	local s = r.steps[r.idx]
	if not s then return end
	if line == s.cmd then return end             -- the modem's own echo

	if is_final(line) then
		local ok = (line == "OK")
		r.result[r.idx] = { cmd = s.cmd, lines = r.lines, final = line, ok = ok }
		if s.parse then
			local good, e = pcall(s.parse, r.lines, ok, line)
			if not good then log("parse %s failed: %s", s.cmd, tostring(e)) end
		end
		if not ok and not s.tolerate then
			M.finish(false, line)
		else
			M.step_send()
		end
	else
		r.lines[#r.lines + 1] = line
	end
end

function M.on_urc(line)
	M.urc[#M.urc + 1] = { t = os.time(), line = line }
	while #M.urc > 32 do table.remove(M.urc, 1) end

	local idx = line:match("^%+CMTI:%s*\"?[^,]*\"?,%s*(%d+)")
	if idx then
		-- provisional: the message is not in our read-state store until the list is
		-- next fetched, so count it separately rather than guessing a key for it.
		-- A long text arrives as one +CMTI per segment, hence the delay before the
		-- real read: four notifications must produce one +CMGL, not four.
		M.sms_pending = (M.sms_pending or 0) + 1
		M.sms_sync_due = os.time() + 4
		M.state.sms = M.state.sms or {}
		M.state.sms.last_index = tonumber(idx)
		M.state.sms.last_arrival = os.time()
		log("new SMS at index %s", idx)
		M.publish()
	end
	if line:match("^%+CUSD:") and M.ussd_wait then
		M.ussd_wait(line)
	end
end

--- The "> " prompt of +CMGS/+CMGW never ends with a newline, so it is matched raw.
function M.on_raw(chunk)
	local r = M.cur
	if not r then return end
	local s = r.steps[r.idx]
	if s and s.term == "prompt" then
		r.raw = r.raw .. chunk
		if r.raw:find(">") then
			r.result[r.idx] = { cmd = s.cmd, prompt = true, ok = true }
			M.step_send()
			return true                  -- caller drops the buffered echo before the body
		end
	end
end

function M.tick_timeout()
	if M.cur and mono() > M.cur.deadline then
		local name = M.cur.name
		M.finish(false, "timeout")
		M.timeouts = (M.timeouts or 0) + 1
		log("timeout on %s (%d in a row)", name, M.timeouts)
		if M.timeouts >= 2 then M.drop("modem not answering") end
	end
end

--================================================================== channel setup

function M.drop(why)
	if M.link.state ~= "down" then log("channel down: %s", why) end
	M.reader:close()
	M.writer:close()
	M.link.state = "down"
	M.link.error = why
	M.timeouts = 0
	if M.cur then M.finish(false, "channel down") end
	while #M.queue > 0 do
		local r = table.remove(M.queue, 1)
		if r.cb then pcall(r.cb, false, {}, "channel down") end
	end
	M.backoff = math.min((M.backoff or 1) * 2, 30)
	M.next_try = mono() + M.backoff
	M.publish()
end

function M.connect()
	M.link.attempts = M.link.attempts + 1
	M.link.state = "connecting"
	M.link.error = nil
	local ok, err = M.writer:start()
	if not ok then
		M.drop("writer connect failed (" .. tostring(err) .. ")")
		return
	end
	ok, err = M.reader:start()
	if not ok then
		M.drop("reader connect failed (" .. tostring(err) .. ")")
		return
	end
	M.stage = "tcp"
	M.stage_deadline = mono() + CFG.connect_wait
end

local CLEAN_MARK = "MODEMD_CLEAN_OK"

--- A `cat /dev/smd7` left over from an earlier run would steal the modem's output, so
--- the writer kills any it finds.  That has to FINISH before the reader starts its own
--- `cat`: doing both at once means the cleanup kills the reader we just armed, which is
--- exactly what happened on the first run.  The marker tells us the shell is done with
--- it -- written with a quote in the middle so that the shell's echo of the command
--- line does not itself match the marker we are waiting for.
function M.clean_sessions()
	M.writer:send("for p in $(ps | grep '[c]at " .. CFG.dev ..
	              "' | awk '{print $1}'); do kill $p; done 2>/dev/null; echo " ..
	              "MODEMD_C''LEAN_OK\n")
	M.writer.rbuf = ""
	M.clean_seen = false
	M.stage = "clean"
	M.stage_deadline = mono() + 8
end

--- Turn the reader session into a raw modem stream: from here on that socket carries
--- nothing but what the modem says.
function M.arm_sessions()
	M.reader:send("exec cat " .. CFG.dev .. "\n")
	M.sync_until = mono() + CFG.sync_window
	M.stage = "sync"
end

function M.on_ready()
	M.link.state = "ready"
	M.link.since = os.time()
	M.link.error = nil
	-- The silence watchdog measures time since the last line from the modem, and lines
	-- also arrive while the channel is still being set up.  When setup takes longer than
	-- the watchdog's two minutes -- it does, when the USB link comes up late at boot --
	-- a stale mark makes the freshly ready channel look dead on its first turn through
	-- the loop, and the daemon drops it immediately after announcing it.  Start the
	-- count here instead.
	M.link.last_ok = mono()
	M.backoff = 1
	M.timeouts = 0
	log("channel ready")
	-- Session setup: verbose errors, text-mode SMS, and -- the important one --
	-- +CMTI notifications, so we learn about new messages without +CMGL, which
	-- would clear the "unread" flag on every poll.
	-- AT+CEREG=2 / AT+CGREG=2 add the cell identity and tracking area to the
	-- registration answer; without them the UI has no cell to show.
	M.enqueue(request("setup", {
		{ cmd = "ATE1", tolerate = true },
		{ cmd = "AT+CMEE=2", tolerate = true },
		{ cmd = "AT+CMGF=1", tolerate = true },
		-- the character set lives in the modem, not in us: a previous run that left it
		-- on UCS2 would otherwise hand us hex operator names for the rest of time
		{ cmd = 'AT+CSCS="IRA"', tolerate = true },
		{ cmd = "AT+CNMI=2,1,0,0,0", tolerate = true },
		-- +CSDH=1 adds the type-of-address and the segment length to every listing,
		-- which is what lets us name text senders and rejoin long messages
		{ cmd = "AT+CSDH=1", tolerate = true },
		{ cmd = "AT+CEREG=2", tolerate = true },
		{ cmd = "AT+CGREG=2", tolerate = true },
	}), true)
	-- bg_static is defined further down, in the polling section
	if M.bg_static then M.enqueue(M.bg_static()) end
	M.bg_due_fast, M.bg_due_slow = 0, 0
	-- after the first poll round, so the count is right before anyone looks at it
	M.sms_sync_due = os.time() + 8
end

--====================================================================== parsers

local S = M.state

M.parsers = {}

local function set(tbl, key, value)
	S[tbl] = S[tbl] or {}
	S[tbl][key] = value
end

function M.parsers.ati_lines(lines)
	for _, l in ipairs(lines) do
		local k, v = l:match("^(%a[%w ]-):%s*(.+)$")
		if k == "Model" then set("device", "model", v)
		elseif k == "Revision" then set("device", "revision", v)
		elseif k == "Manufacturer" then set("device", "vendor", v)
		elseif k == "IMEI" then set("device", "imei", v) end
	end
end

-- RSSI in dBm from the 0..31 scale of +CSQ, and 0..5 "bars" the UI can draw.
local function csq_to_dbm(csq)
	if not csq or csq == 99 then return nil end
	return -113 + 2 * csq
end

local function bars_from(rsrp, dbm)
	local v = rsrp or dbm
	if not v then return 0 end
	if rsrp then
		if rsrp >= -85 then return 5
		elseif rsrp >= -95 then return 4
		elseif rsrp >= -105 then return 3
		elseif rsrp >= -115 then return 2
		elseif rsrp >= -125 then return 1 end
		return 0
	end
	if dbm >= -65 then return 5
	elseif dbm >= -75 then return 4
	elseif dbm >= -85 then return 3
	elseif dbm >= -95 then return 2
	elseif dbm >= -105 then return 1 end
	return 0
end

local function recalc_bars()
	local sig = S.signal or {}
	sig.bars = bars_from(sig.rsrp, sig.rssi_dbm)
	S.signal = sig
end

--- The modem writes IPv6 as sixteen dotted decimals.  Nobody can read that, so fold it
--- back into normal notation, longest zero run collapsed as the RFC wants.
local function dotted_to_ipv6(s)
	local b = {}
	for n in s:gmatch("(%d+)") do b[#b + 1] = tonumber(n) end
	if #b ~= 16 then return nil end
	local g, all_zero = {}, true
	for i = 1, 16, 2 do
		local v = b[i] * 256 + b[i + 1]
		if v ~= 0 then all_zero = false end
		g[#g + 1] = ("%x"):format(v)
	end
	if all_zero then return nil end
	local bs, bn, i = nil, 1, 1
	while i <= 8 do
		if g[i] == "0" then
			local j = i
			while j < 8 and g[j + 1] == "0" do j = j + 1 end
			if j - i + 1 > bn then bs, bn = i, j - i + 1 end
			i = j + 1
		else
			i = i + 1
		end
	end
	if not bs then return table.concat(g, ":") end
	return table.concat(g, ":", 1, bs - 1) .. "::" ..
	       ((bs + bn <= 8) and table.concat(g, ":", bs + bn, 8) or "")
end

local function dots(s) return select(2, s:gsub("%.", "")) end

--- Radio levels arrive with two decimals ("-098.10").  The JSON encoder prints a
--- rounded double with all seventeen digits it has, so -117.9 comes out as
--- -117.90000000000001; whole dB is what a UI shows anyway, so round here.
local function round(v)
	if type(v) ~= "number" then return v end
	return math.floor(v + 0.5)
end

--- Pull the first usable IPv4 / IPv6 out of a field that may hold both, space separated.
local function v4_of(s)
	for tok in s:gmatch("[%d%.]+") do
		if dots(tok) == 3 and tok ~= "0.0.0.0" then return tok end
	end
end

local function v6_of(s)
	for tok in s:gmatch("[%d%.]+") do
		if dots(tok) == 15 then
			local a = dotted_to_ipv6(tok)
			if a then return a end
		end
	end
end

-- Downlink EARFCN -> LTE band (3GPP 36.101 table 5.7.3-1).  The modem will not tell us
-- the band, but it does tell us the channel, and the mapping is fixed.
local EARFCN_BANDS = {
	{0,599,1}, {600,1199,2}, {1200,1949,3}, {1950,2399,4}, {2400,2649,5},
	{2650,2749,6}, {2750,3449,7}, {3450,3799,8}, {3800,4149,9}, {4150,4749,10},
	{4750,4949,11}, {5010,5179,12}, {5180,5279,13}, {5280,5379,14}, {5730,5849,17},
	{5850,5999,18}, {6000,6149,19}, {6150,6449,20}, {6450,6599,21}, {6600,7399,22},
	{7500,7699,23}, {7700,8039,24}, {8040,8689,25}, {8690,9039,26}, {9040,9209,27},
	{9210,9659,28}, {9660,9769,29}, {9770,9869,30}, {9870,9919,31}, {9920,10359,32},
	{36000,36199,33}, {36200,36349,34}, {36350,36949,35}, {36950,37549,36},
	{37550,37749,37}, {37750,38249,38}, {38250,38649,39}, {38650,39649,40},
	{39650,41589,41}, {41590,43589,42}, {43590,45589,43}, {45590,46589,44},
}

local function band_of(earfcn)
	if not earfcn then return nil end
	for _, r in ipairs(EARFCN_BANDS) do
		if earfcn >= r[1] and earfcn <= r[2] then return r[3] end
	end
end

function M.parsers.csq(lines)
	for _, l in ipairs(lines) do
		local rssi, ber = l:match("^%+CSQ:%s*(%d+),%s*(%d+)")
		if rssi then
			rssi = tonumber(rssi)
			set("signal", "csq", rssi)
			set("signal", "rssi_dbm", csq_to_dbm(rssi))
			set("signal", "ber", tonumber(ber))
			recalc_bars()
		end
	end
end

local ACT_NAME = {
	[0] = "GSM", [1] = "GSM Compact", [2] = "UTRAN", [3] = "GSM/EDGE",
	[4] = "UTRAN/HSDPA", [5] = "UTRAN/HSUPA", [6] = "UTRAN/HSPA",
	[7] = "LTE", [8] = "EC-GSM-IoT", [9] = "LTE Cat-M1", [10] = "NB-IoT",
}

--- Some modems answer AT+COPS? with the network name written twice ("lifecell
--- lifecell"): the long and the short EONS name are identical and the firmware
--- concatenates them instead of picking one.  Both AT+COPS=3,0 and =3,1 give the
--- same doubled string on this modem, and the SPN commands (+CSPN, $QCSPN, +QSPN)
--- all answer ERROR, so there is nothing better to read -- fold the repetition here.
local function dedup_name(s)
	if not s or s == "" then return s end
	local words = {}
	for w in s:gmatch("%S+") do words[#words + 1] = w end
	if #words < 2 or #words % 2 ~= 0 then
		-- "X X X ..." -- every word the same
		local same = true
		for i = 2, #words do
			if words[i]:lower() ~= words[1]:lower() then same = false break end
		end
		if same and #words > 1 then return words[1] end
		return s
	end
	-- "A B A B" -- the second half repeats the first
	local half = math.floor(#words / 2)
	for i = 1, half do
		if words[i]:lower() ~= words[half + i]:lower() then return s end
	end
	return table.concat(words, " ", 1, half)
end

function M.parsers.cops(lines)
	for _, l in ipairs(lines) do
		local mode, fmt, name, act = l:match('^%+COPS:%s*(%d+),?%s*(%d*),?%s*"?([^",]*)"?,?%s*(%d*)')
		if mode then
			set("net", "cops_mode", tonumber(mode))
			set("net", "auto", tonumber(mode) == 0)
			if name and name ~= "" then
				set("net", "operator", dedup_name(trim(name)))
			end
			act = tonumber(act)
			if act then
				set("net", "act", act)
				set("net", "act_name", ACT_NAME[act] or ("ACT " .. act))
			end
		elseif l:match("^%+COPS:%s*%d+%s*$") then
			set("net", "cops_mode", tonumber(l:match("(%d+)")))
		end
	end
end

local REG_STATE = {
	[0] = "not registered", [1] = "registered", [2] = "searching",
	[3] = "denied", [4] = "unknown", [5] = "roaming",
}

--- With AT+CEREG=2 the answer carries the cell as well:
---   +CEREG: <n>,<stat>,"<tac>",["<rac>",]"<ci>",<AcT>
--- The middle field is not present on every firmware, so take the *last* quoted value
--- as the cell identity rather than counting from the left.
function M.parsers.cereg(lines)
	for _, l in ipairs(lines) do
		local st = l:match("^%+CEREG:%s*%d+,%s*(%d+)")
		if st then
			st = tonumber(st)
			set("net", "reg", st)
			set("net", "reg_name", REG_STATE[st] or "?")
			set("net", "registered", st == 1 or st == 5)
			set("net", "roaming", st == 5)

			local quoted = {}
			for q in l:gmatch('"([^"]*)"') do quoted[#quoted + 1] = q end
			if #quoted >= 2 then
				set("net", "tac", quoted[1])
				local ci = quoted[#quoted]
				set("net", "ci", ci)
				local num = tonumber(ci, 16)
				if num then
					-- an LTE cell identity is 28 bits: eNodeB in the top 20, sector
					-- in the bottom 8
					set("net", "enb", math.floor(num / 256))
					set("net", "sector", num % 256)
				end
			end
			local act = tonumber(l:match(",(%d+)%s*$") or "")
			if act and #quoted >= 2 then
				set("net", "act", act)
				set("net", "act_name", ACT_NAME[act] or ("ACT " .. act))
			end
		end
	end
end

function M.parsers.sysmode(lines)
	for _, l in ipairs(lines) do
		local v = trim(l)
		if v ~= "" and not v:match("^%+") then set("net", "sysmode", v) end
	end
end

function M.parsers.sysinfo(lines)
	for _, l in ipairs(lines) do
		local a, b, c, d, e = l:match("^%^SYSINFO:%s*(%d+),(%d+),(%d+),(%d+),(%d+)")
		if a then
			set("net", "srv_status", tonumber(a))
			set("net", "srv_domain", tonumber(b))
			set("net", "roaming", tonumber(c) == 1 or S.net.roaming)
			set("net", "sim_state", tonumber(e))
		end
	end
end

-- $QCRSRP: <pci>,<earfcn>,"<dBm>",...  first triple is the serving cell
local function parse_triples(lines, tag)
	local list = {}
	for _, l in ipairs(lines) do
		local body = l:match("^%$" .. tag .. ":%s*(.+)$")
		if body then
			local f = {}
			for item in (body .. ","):gmatch("([^,]*),") do f[#f + 1] = trim(item) end
			for i = 1, #f - 2, 3 do
				local pci, earfcn = tonumber(f[i]), tonumber(f[i + 1])
				-- the extra parentheses matter: gsub returns a count as its second
				-- value, which tonumber would otherwise take as a number base
				local val = tonumber(((f[i + 2] or ""):gsub('"', '')))
				if pci and val then
					list[#list + 1] = { pci = pci, earfcn = earfcn, value = val,
					                    band = band_of(earfcn) }
				end
			end
		end
	end
	return list
end

function M.parsers.rsrp(lines)
	local l = parse_triples(lines, "QCRSRP")
	if #l > 0 then
		set("signal", "rsrp", round(l[1].value))
		set("signal", "pci", l[1].pci)
		set("signal", "earfcn", l[1].earfcn)
		set("signal", "band", band_of(l[1].earfcn))
		local nb = {}
		for i = 2, #l do
			nb[#nb + 1] = { pci = l[i].pci, earfcn = l[i].earfcn,
			                band = l[i].band, rsrp = round(l[i].value) }
		end
		set("signal", "neighbours", nb)
		recalc_bars()
	end
end

function M.parsers.rsrq(lines)
	local l = parse_triples(lines, "QCRSRQ")
	if #l > 0 then set("signal", "rsrq", round(l[1].value)) end
end

function M.parsers.cpin(lines, ok, final)
	for _, l in ipairs(lines) do
		local v = l:match("^%+CPIN:%s*(.+)$")
		if v then
			v = trim(v)
			set("sim", "status", v)
			set("sim", "ready", v == "READY")
			set("sim", "pin_required", v:match("SIM PIN") ~= nil)
			set("sim", "puk_required", v:match("SIM PUK") ~= nil)
		end
	end
	if not ok then
		set("sim", "status", "absent")
		set("sim", "ready", false)
		set("sim", "error", final)
	end
end

function M.parsers.pinstat(lines)
	for _, l in ipairs(lines) do
		local body = l:match("^%$QCPINSTAT:%s*(.+)$")
		if body then set("sim", "pinstat", trim(body)) end
	end
end

function M.parsers.cgdcont(lines)
	local list = {}
	for _, l in ipairs(lines) do
		local cid, pdp, apn = l:match('^%+CGDCONT:%s*(%d+),"([^"]*)","([^"]*)"')
		if cid then
			cid = tonumber(cid)
			list[#list + 1] = {
				cid = cid, pdp_type = pdp, apn = apn,
				active = (M.cgact or {})[tostring(cid)] or false,
				auth = (M.cgauth or {})[tostring(cid)],
				auth_name = (M.cgauth_name or {})[tostring(cid)],
			}
		end
	end
	if #list > 0 then
		S.apn = { count = #list, list = list }
		-- the profile the data call actually runs on, not simply the first one
		local active = list[1]
		for _, e in ipairs(list) do
			if e.active and e.apn ~= "" then active = e break end
		end
		set("data", "apn", active.apn)
		set("data", "pdp_type", active.pdp_type)
		set("data", "profile_cid", active.cid)
	end
end

--- +CGACT: <cid>,<state> for every defined context.
function M.parsers.cgact(lines)
	local m = {}
	for _, l in ipairs(lines) do
		local cid, st = l:match("^%+CGACT:%s*(%d+),%s*(%d+)")
		if cid then m[cid] = (tonumber(st) == 1) end
	end
	M.cgact = m
	for _, e in ipairs((S.apn or {}).list or {}) do
		e.active = m[tostring(e.cid)] or false
	end
end

local AUTH_NAME = { [0] = "none", [1] = "PAP", [2] = "CHAP", [3] = "PAP/CHAP" }

local function copy_list(t)
	local out = {}
	for i, v in ipairs(t or {}) do out[i] = v end
	return out
end

--- $QCPDPP: <cid>,<auth type> -- the Qualcomm stand-in for +CGAUTH, which this
--- firmware does not implement.
function M.parsers.qcpdpp(lines)
	local m, names = {}, {}
	for _, l in ipairs(lines) do
		local cid, a = l:match("^%$QCPDPP:%s*(%d+),%s*(%d+)")
		if cid then
			m[cid] = tonumber(a)
			names[cid] = AUTH_NAME[tonumber(a)] or tostring(a)
		end
	end
	M.cgauth, M.cgauth_name = m, names
	for _, e in ipairs((S.apn or {}).list or {}) do
		e.auth = m[tostring(e.cid)]
		e.auth_name = names[tostring(e.cid)]
	end
end

--- Every defined context answers +CGPADDR, most of them with all zeros.  Taking the
--- last line -- which the first version did -- therefore reported "0.0.0.0" while the
--- link was up: pick the first context that actually holds an address instead.
function M.parsers.cgpaddr(lines)
	local per = {}
	for _, l in ipairs(lines) do
		local cid, body = l:match("^%+CGPADDR:%s*(%d+),%s*(.+)$")
		if cid then
			local e = { cid = tonumber(cid) }
			for a in (body .. ","):gmatch('%s*"?([^",]*)"?,') do
				a = trim(a)
				if dots(a) == 3 and a ~= "0.0.0.0" then e.ipv4 = a
				elseif dots(a) == 15 then e.ipv6 = dotted_to_ipv6(a) end
			end
			if e.ipv4 or e.ipv6 then per[#per + 1] = e end
		end
	end
	if #per > 0 then
		set("data", "cid", per[1].cid)
		set("data", "ipv4", per[1].ipv4)
		set("data", "ipv6", per[1].ipv6)
		set("data", "connected", true)
	else
		set("data", "ipv4", nil)
		set("data", "ipv6", nil)
		set("data", "connected", false)
	end
end

--- +CGCONTRDP is where the gateway and the DNS servers live.  The field layout is
--- positional (3GPP 27.007): address, gateway, primary DNS, secondary DNS -- and this
--- firmware puts the IPv4 and IPv6 forms of each in the same field, space separated.
function M.parsers.cgcontrdp(lines)
	for _, l in ipairs(lines) do
		local body = l:match("^%+CGCONTRDP:%s*(.+)$")
		if body then
			local f = {}
			for item in (body .. ","):gmatch("([^,]*),") do f[#f + 1] = trim(item) end
			if #f >= 6 then
				local cid = tonumber(f[1])
				local a = {}
				for i = 4, #f do a[#a + 1] = f[i] end
				local n = #a
				local rd = { cid = cid, apn = f[3], dns = {}, dns6 = {} }
				for _, idx in ipairs({ n - 1, n }) do
					local s4, s6 = v4_of(a[idx] or ""), v6_of(a[idx] or "")
					if s4 then rd.dns[#rd.dns + 1] = s4 end
					if s6 then rd.dns6[#rd.dns6 + 1] = s6 end
				end
				rd.gw = v4_of(a[n - 2] or "") or v6_of(a[n - 2] or "")
				rd.ipv4 = v4_of(a[1] or "")
				rd.ipv6 = v6_of(a[1] or "") or v6_of(a[2] or "")
				if not S.data or not S.data.cid or S.data.cid == cid then
					set("data", "gw", rd.gw)
					set("data", "dns", copy_list(rd.dns))
					set("data", "dns6", copy_list(rd.dns6))
				end
			end
		end
	end
end

function M.parsers.cpms(lines)
	for _, l in ipairs(lines) do
		local m1, u1, t1 = l:match('^%+CPMS:%s*"([^"]*)",(%d+),(%d+)')
		if m1 then
			S.sms = S.sms or {}
			S.sms.storage = m1
			S.sms.used = tonumber(u1)
			S.sms.total = tonumber(t1)
		end
	end
end

--- AT+COPS=3,2 switches the answer to the numeric operator id; the caller has to put
--- the format back afterwards, so this only ever runs inside the one-shot block.
function M.parsers.cops_numeric(lines)
	for _, l in ipairs(lines) do
		local num = l:match('^%+COPS:%s*%d+,%s*2,%s*"(%d+)"')
		if num then
			set("net", "operator_numeric", num)
			set("net", "mcc", num:sub(1, 3))
			set("net", "mnc", num:sub(4))
		end
	end
end

function M.parsers.cimi(lines)
	for _, l in ipairs(lines) do
		local v = trim(l)
		if v:match("^%d%d%d%d%d+$") then
			set("sim", "imsi", v)
			set("sim", "mcc", v:sub(1, 3))
		end
	end
end

function M.parsers.iccid(lines)
	for _, l in ipairs(lines) do
		local v = l:match("^%+?ICCID:%s*(%w+)") or trim(l):match("^(%d%d%d%d%d%d+%w*)$")
		if v then set("sim", "iccid", v) end
	end
end

function M.parsers.simstat(lines)
	for _, l in ipairs(lines) do
		local _, txt = l:match("^%$QCSIMSTAT:%s*(%d+),%s*(.+)$")
		if txt then set("sim", "init", trim(txt)) end
	end
end

--- +CLCK: <status> -- whether the SIM asks for a PIN at power-on.
function M.parsers.clck(lines)
	for _, l in ipairs(lines) do
		local v = l:match("^%+CLCK:%s*(%d+)")
		if v then set("sim", "pin_enabled", tonumber(v) == 1) end
	end
end

function M.parsers.cnum(lines)
	for _, l in ipairs(lines) do
		local num = l:match('^%+CNUM:%s*[^,]*,%s*"([^"]*)"')
		if num and num ~= "" then set("sim", "number", num) end
	end
end

function M.parsers.cfun(lines)
	for _, l in ipairs(lines) do
		local v = l:match("^%+CFUN:%s*(%d+)")
		if v then
			S.radio = S.radio or {}
			S.radio.cfun = tonumber(v)
			S.radio.on = tonumber(v) == 1
		end
	end
end

function M.parsers.cgatt(lines)
	for _, l in ipairs(lines) do
		local v = l:match("^%+CGATT:%s*(%d+)")
		if v then set("net", "attached", tonumber(v) == 1) end
	end
end

-- Which radio technologies the modem may use.  AT cannot set this here: +WS46 answers
-- OK and keeps the old value, and every vendor command ($QCRAT, ^SYSCFG, ^SYSCFGEX,
-- +CNMP, !SELRAT, +GTRAT, +ZSNT, +XACT, $NWRAT) answers ERROR.  The stock UI never
-- went through AT either -- it asks core_app on the Qualcomm side, and so do we.
local NET_MODE_NAME = {
	[0] = "Automatic (2G/3G/4G)", [1] = "2G only", [2] = "3G only", [3] = "4G only",
}

-- GetNetworkModeListType answers "unknown error" on this firmware, so the stock UI
-- hard-codes these four (build.js, formOptions.NetworkMode) and we do the same.
local NET_MODES = {
	{ value = 0, name = NET_MODE_NAME[0] }, { value = 1, name = NET_MODE_NAME[1] },
	{ value = 2, name = NET_MODE_NAME[2] }, { value = 3, name = NET_MODE_NAME[3] },
}

--- Board detection can only name the family: nothing on the Realtek half records
--- which model this is, and the same image runs on an HH71 without the VM.  The
--- Qualcomm half knows -- GetSystemInfo returns the hardware string the stock UI
--- shows -- so refine what the boot script wrote once we can ask.
function M.refresh_model()
	local info = KCAP.call("GetSystemInfo")
	local hw = info and info.HwVersion
	if type(hw) ~= "string" then return false end
	hw = trim(hw)
	if hw == "" then return false end
	local model = "Alcatel LINKHUB " .. hw
	local cur = fs.readfile("/tmp/sysinfo/model")
	if cur and trim(cur) == model then return true end
	fs.mkdir("/tmp/sysinfo")
	fs.writefile("/tmp/sysinfo/model", model .. "\n")
	log("model from the modem side: %s", model)
	return true
end

--- Read the mode over the kcap channel into the published snapshot.
function M.net_mode_refresh()
	local ns, err = KCAP.call("GetNetworkSettings")
	S.net = S.net or {}
	if not ns or ns.NetworkMode == nil then
		S.net.mode_error = err or "no answer"
		return nil, S.net.mode_error
	end
	S.net.mode_error = nil
	set("net", "mode", ns.NetworkMode)
	set("net", "mode_name", NET_MODE_NAME[ns.NetworkMode]
	                        or ("mode " .. tostring(ns.NetworkMode)))
	set("net", "modes", NET_MODES)
	return ns
end


--- +CCLK: "yy/MM/dd,hh:mm:ss+zz" -- the network's idea of the time, quarter hours.
function M.parsers.cclk(lines)
	for _, l in ipairs(lines) do
		local v = l:match('^%+CCLK:%s*"([^"]*)"')
		if v then
			set("net", "time", v)
			local tz = v:match("([%+%-]%d+)$")
			if tz then set("net", "tz_minutes", tonumber(tz) * 15) end
		end
	end
end

function M.parsers.csca(lines)
	for _, l in ipairs(lines) do
		local v = l:match('^%+CSCA:%s*"([^"]*)"')
		if v then
			S.sms = S.sms or {}
			S.sms.sca = v
		end
	end
end

function M.parsers.cpbs(lines)
	for _, l in ipairs(lines) do
		local st, used, total = l:match('^%+CPBS:%s*"([^"]*)",(%d+),(%d+)')
		if st then
			S.phonebook = { storage = st, used = tonumber(used), total = tonumber(total) }
		end
	end
end

--============================================================== traffic counters

local function read_counters()
	local f = io.open("/proc/net/dev", "r")
	if not f then return nil end
	local rx, tx
	for line in f:lines() do
		local ifn, body = line:match("^%s*([%w%.%-]+):%s*(.+)$")
		if ifn == CFG.wan_if then
			local fields = {}
			for v in body:gmatch("%d+") do fields[#fields + 1] = tonumber(v) end
			rx, tx = fields[1], fields[9]
		end
	end
	f:close()
	if not rx then return nil end
	return rx, tx
end

function M.update_usage()
	local rx, tx = read_counters()
	if not rx then return end
	M.usage_base = M.usage_base or { rx = rx, tx = tx, t = os.time() }
	if rx < M.usage_base.rx or tx < M.usage_base.tx then      -- counters reset
		M.usage_base = { rx = rx, tx = tx, t = os.time() }
	end
	S.usage = {
		rx_total = rx, tx_total = tx,
		rx = rx - M.usage_base.rx, tx = tx - M.usage_base.tx,
		since = M.usage_base.t, iface = CFG.wan_if,
	}
end

--=================================================================== background

local function bg_fast()
	return request("poll-fast", {
		{ cmd = "AT+CSQ",     parse = M.parsers.csq,    tolerate = true },
		{ cmd = "AT+CEREG?",  parse = M.parsers.cereg,  tolerate = true },
	}, function() M.publish() end)
end

local function bg_slow()
	return request("poll-slow", {
		{ cmd = "AT+CPIN?",       parse = M.parsers.cpin,    tolerate = true },
		{ cmd = "AT+COPS?",       parse = M.parsers.cops,    tolerate = true },
		{ cmd = "AT+CFUN?",       parse = M.parsers.cfun,    tolerate = true },
		{ cmd = "AT+CGATT?",      parse = M.parsers.cgatt,   tolerate = true },
		{ cmd = "AT$QCSYSMODE?",  parse = M.parsers.sysmode, tolerate = true },
		{ cmd = "AT^SYSINFO",     parse = M.parsers.sysinfo, tolerate = true },
		{ cmd = "AT$QCRSRP?",     parse = M.parsers.rsrp,    tolerate = true },
		{ cmd = "AT$QCRSRQ?",     parse = M.parsers.rsrq,    tolerate = true },
		{ cmd = "AT$QCPDPP?",     parse = M.parsers.qcpdpp,  tolerate = true },
		{ cmd = "AT+CGACT?",      parse = M.parsers.cgact,   tolerate = true },
		{ cmd = "AT+CGDCONT?",    parse = M.parsers.cgdcont, tolerate = true },
		{ cmd = "AT+CGPADDR",     parse = M.parsers.cgpaddr, tolerate = true },
		{ cmd = "AT+CGCONTRDP",   parse = M.parsers.cgcontrdp, tolerate = true },
		{ cmd = "AT+CPMS?",       parse = M.parsers.cpms,    tolerate = true },
		{ cmd = "AT+CCLK?",       parse = M.parsers.cclk,    tolerate = true },
	}, function() M.publish() end)
end

--- Facts that do not change while the modem is up: asked once per channel, not on a
--- timer.  Keeping them out of the slow poll saves a dozen AT round trips a minute.
local function bg_static()
	return request("poll-static", {
		{ cmd = "ATI",           parse = M.parsers.ati_lines, tolerate = true },
		{ cmd = "AT+CIMI",       parse = M.parsers.cimi,    tolerate = true },
		{ cmd = "AT+ICCID",      parse = M.parsers.iccid,   tolerate = true },
		{ cmd = "AT+CNUM",       parse = M.parsers.cnum,    tolerate = true },
		{ cmd = "AT$QCSIMSTAT?", parse = M.parsers.simstat, tolerate = true },
		{ cmd = 'AT+CLCK="SC",2', parse = M.parsers.clck,   tolerate = true },
		{ cmd = "AT+CSCA?",      parse = M.parsers.csca,    tolerate = true },
		{ cmd = "AT+CPBS?",      parse = M.parsers.cpbs,    tolerate = true },
		{ cmd = "AT+COPS=3,2",   tolerate = true },
		{ cmd = "AT+COPS?",      parse = M.parsers.cops_numeric, tolerate = true },
		{ cmd = "AT+COPS=3,0",   tolerate = true },
		{ cmd = "AT+COPS?",      parse = M.parsers.cops,    tolerate = true },
	}, function() M.publish() end)
end

M.bg_static = bg_static

function M.publish()
	M.update_usage()
	if M.sms_unread_fn then M.sms_unread_fn() end
	S.ts = os.time()
	S.link = {
		state = M.link.state, since = M.link.since,
		error = M.link.error, attempts = M.link.attempts,
	}
	local body = json.stringify(S)
	local tmp = STATUS_FILE .. ".tmp"
	local f = io.open(tmp, "w")
	if f then
		f:write(body)
		f:close()
		fs.move(tmp, STATUS_FILE)
	end
end

--=========================================================== SMS read/unread state
-- AT+CMGL clears the modem's own "unread" flag on every message it returns, so that
-- flag cannot survive the first time the user opens the message list.  We therefore
-- keep the state ourselves, keyed by index plus timestamp (indexes are reused after a
-- delete), seeded from the modem's flag the first time a message is seen.

local SMS_SEEN_FILE = "/etc/hh71vm-modem/sms-seen.json"

local SMS = { seen = {}, loaded = false }

local function sms_key(index, ts)
	return tostring(index) .. "|" .. tostring(ts or "")
end

function SMS.load()
	if SMS.loaded then return end
	SMS.loaded = true
	local f = io.open(SMS_SEEN_FILE, "r")
	if not f then return end
	local body = f:read("*a")
	f:close()
	local t = body and json.parse(body)
	if type(t) == "table" and type(t.seen) == "table" then SMS.seen = t.seen end
end

function SMS.save()
	local dir = SMS_SEEN_FILE:match("^(.*)/[^/]*$")
	if dir then fs.mkdirr(dir) end
	local f = io.open(SMS_SEEN_FILE .. ".tmp", "w")
	if not f then return end
	f:write(json.stringify({ seen = SMS.seen }))
	f:close()
	fs.move(SMS_SEEN_FILE .. ".tmp", SMS_SEEN_FILE)
end

--- How many messages the store knows about.  Deliberately not the same number as
--- AT+CPMS reports: that counts storage slots, and one long text takes several of
--- them, so the modem says "6" where the user sees two messages.
function SMS.count_all()
	SMS.load()
	local n = 0
	for _ in pairs(SMS.seen) do n = n + 1 end
	return n
end

function SMS.count_unread()
	SMS.load()
	local n = 0
	for _, v in pairs(SMS.seen) do if v == "unread" then n = n + 1 end end
	return n
end

--- Fold a freshly listed set into the store, drop entries for messages that are gone,
--- and stamp each message with our own read flag.  Returns the unread count.
function SMS.merge(msgs)
	SMS.load()
	local keep, unread = {}, 0
	for _, m in ipairs(msgs) do
		local k = sms_key(m.index, m.ts)
		local st = SMS.seen[k]
		if st == nil then st = m.unread and "unread" or "read" end
		keep[k] = st
		m.unread = (st == "unread")
		if m.unread then unread = unread + 1 end
	end
	SMS.seen = keep
	SMS.save()
	return unread
end

function SMS.mark(index, ts, state)
	SMS.load()
	local changed = false
	if ts and ts ~= "" then
		local k = sms_key(index, ts)
		if SMS.seen[k] ~= state then SMS.seen[k] = state; changed = true end
	else
		local pfx = tostring(index) .. "|"
		for k in pairs(SMS.seen) do
			if k:sub(1, #pfx) == pfx and SMS.seen[k] ~= state then
				SMS.seen[k] = state; changed = true
			end
		end
	end
	if changed then SMS.save() end
	return changed
end

function SMS.forget(index)
	SMS.load()
	local pfx = tostring(index) .. "|"
	for k in pairs(SMS.seen) do
		if k:sub(1, #pfx) == pfx then SMS.seen[k] = nil end
	end
	SMS.save()
end

local function sms_refresh_unread()
	S.sms = S.sms or {}
	-- +CMTI fires once per *slot*, and a long text fills several, so the count of
	-- outstanding notifications is not a count of messages.  Until the next sync
	-- merges them, say that at least one arrived rather than inflating the badge.
	local pending = (M.sms_pending or 0) > 0
	S.sms.pending = pending
	S.sms.unread = SMS.count_unread() + (pending and 1 or 0)
	local n = SMS.count_all()
	-- An empty store with occupied slots means the list has never been fetched in
	-- this session; say "unknown" rather than "none", which would be a lie.
	S.sms.count = (n == 0 and (S.sms.used or 0) > 0) and nil or n
end

M.sms_unread_fn = sms_refresh_unread

--================================================================ control socket

local API = {}

--- An answer can run to tens of kilobytes (an SMS list, an operator scan) while the
--- client socket is non-blocking, so a single write would truncate the JSON without
--- saying so.  Switch to blocking and write until it is all out.
local function reply(cli, obj)
	if cli.dead then return end
	local ok, body = pcall(json.stringify, obj)
	if not ok then body = '{"error":"encode failed"}' end
	body = body .. "\n"
	pcall(function()
		cli.sock:setblocking(true)
		while #body > 0 do
			local n = cli.sock:write(body)
			if not n or n <= 0 then break end
			body = body:sub(n + 1)
		end
		cli.sock:close()
	end)
	cli.dead = true
end

local function need_link(cli)
	if M.link.state ~= "ready" then
		reply(cli, { error = "modem channel " .. M.link.state,
		             detail = M.link.error })
		return false
	end
	return true
end

--- Run AT steps for a control client and answer with the collected lines.
local function run_for(cli, name, steps, shape)
	if not need_link(cli) then return end
	M.enqueue(request(name, steps, function(ok, result, err)
		if shape then
			local out = shape(ok, result, err) or {}
			if out.ok == nil then out.ok = ok end
			reply(cli, out)
		else
			local lines = {}
			for _, st in ipairs(result) do
				for _, l in ipairs(st.lines or {}) do lines[#lines + 1] = l end
			end
			reply(cli, { ok = ok, error = err, lines = lines })
		end
	end))
	M.start_next()
end

function API.status(cli)
	M.update_usage()
	if M.sms_unread_fn then M.sms_unread_fn() end
	S.ts = os.time()
	S.link = { state = M.link.state, since = M.link.since,
	           error = M.link.error, attempts = M.link.attempts }
	reply(cli, S)
end

function API.refresh(cli, args)
	if not need_link(cli) then return end
	local r = bg_slow()
	r.cb = function(ok, _, err)
		M.publish()
		API.status(cli)
	end
	M.enqueue(r, true)
	M.start_next()
end

function API.at(cli, args)
	local cmds = args.cmds or (args.cmd and { args.cmd })
	if type(cmds) ~= "table" or #cmds == 0 then
		return reply(cli, { error = "no commands given" })
	end
	local steps = {}
	for _, c in ipairs(cmds) do
		steps[#steps + 1] = { cmd = tostring(c), tolerate = true,
		                      timeout = tonumber(args.timeout) or CFG.at_timeout }
	end
	run_for(cli, "at", steps, function(ok, result, err)
		local out = { ok = ok, error = err, results = {} }
		for i, st in ipairs(result) do
			out.results[i] = { cmd = st.cmd, final = st.final, lines = st.lines }
		end
		return out
	end)
end

--- Build the job that reads the modem's message store and folds it into ours.
---
--- +CMGL clears the modem's own "unread" flag on everything it returns, which is why
--- this is never a poll.  It is safe at exactly two moments -- when the channel comes
--- up and just after a +CMTI -- because those are the moments the modem's flag is
--- still the truth, and from then on the read state is ours (SMS.seen).
local function sms_list_job(done)
	local msgs = {}
	local function parse(lines)
		local i = 1
		while i <= #lines do
			-- with +CSDH=1: index, status, address, [alpha], timestamp, toa, length
			local idx, stat, addr, ts, toa, len =
				lines[i]:match('^%+CMGL:%s*(%d+),"([^"]*)","([^"]*)",[^,]*,"([^"]*)",(%d+),(%d+)')
			if not idx then
				idx, stat, addr, ts =
					lines[i]:match('^%+CMGL:%s*(%d+),"([^"]*)","([^"]*)",[^,]*,"([^"]*)"')
			end
			if not idx then
				idx, stat, addr = lines[i]:match('^%+CMGL:%s*(%d+),"([^"]*)","([^"]*)"')
			end
			if idx then
				local body = lines[i + 1] or ""
				msgs[#msgs + 1] = {
					index = tonumber(idx), status = stat,
					sender = decode_addr(addr, toa), raw_sender = addr,
					ts = ts, len = tonumber(len),
					text = decode_body(body),
					unread = stat:match("UNREAD") ~= nil,
				}
				i = i + 2
			else
				i = i + 1
			end
		end
	end
	return request("sms_list", {
		{ cmd = "AT+CMGF=1", tolerate = true },
		{ cmd = "AT+CPMS?", parse = M.parsers.cpms, tolerate = true },
		{ cmd = 'AT+CMGL="ALL"', parse = parse, tolerate = true, timeout = 40 },
	}, function(ok, _, err)
		S.sms = S.sms or {}
		local list = group_segments(msgs)
		if ok then
			M.sms_pending = 0
			S.sms.unread = SMS.merge(list)
		end
		M.publish()
		done(ok, list, err, #msgs)
	end)
end

function API.sms_list(cli, args)
	if not need_link(cli) then return end
	M.enqueue(sms_list_job(function(ok, list, err, segments)
		reply(cli, { ok = ok, error = err, count = #list,
		             segments = segments, messages = list })
	end))
	M.start_next()
end

--- The same read, with nobody asking.  Without it the message counter is whatever the
--- store on disk happened to hold at boot -- which is how the status bar came up
--- saying "SMS 0" until the messages page was opened once.
function M.sms_sync(why)
	if M.link.state ~= "ready" or M.sms_syncing then return end
	M.sms_syncing = true
	log("syncing message store (%s)", why)
	M.enqueue(sms_list_job(function() M.sms_syncing = false end))
	M.start_next()
end

function API.sms_read(cli, args)
	local idx = tonumber(args.index)
	if not idx then return reply(cli, { error = "index required" }) end
	local msg = {}
	run_for(cli, "sms_read", {
		{ cmd = "AT+CMGF=1", tolerate = true },
		{ cmd = "AT+CMGR=" .. idx, tolerate = true, parse = function(lines)
			for i, l in ipairs(lines) do
				local stat, addr, ts, toa =
					l:match('^%+CMGR:%s*"([^"]*)","([^"]*)",[^,]*,"([^"]*)",(%d+)')
				if not stat then
					stat, addr, ts = l:match('^%+CMGR:%s*"([^"]*)","([^"]*)",[^,]*,"([^"]*)"')
				end
				if not stat then
					-- a stored draft has no service-centre timestamp at all
					stat, addr = l:match('^%+CMGR:%s*"([^"]*)","([^"]*)"')
				end
				if stat then
					msg = { index = idx, status = stat, sender = decode_addr(addr, toa),
					        ts = ts, text = decode_body(lines[i + 1] or ""),
					        unread = stat:match("UNREAD") ~= nil }
				end
			end
		end },
	}, function(ok, _, err)
		if ok and msg.index then
			SMS.mark(msg.index, msg.ts, "read")
			if (M.sms_pending or 0) > 0 then M.sms_pending = M.sms_pending - 1 end
			M.publish()
		end
		return { ok = ok, error = err, message = msg }
	end)
end

--- Let the UI put a message back to unread, or mark one read without fetching it.
function API.sms_mark(cli, args)
	local idx = tonumber(args.index)
	if not idx then return reply(cli, { error = "index required" }) end
	local state = (args.read == false) and "unread" or "read"
	SMS.mark(idx, args.ts, state)
	if state == "read" and (M.sms_pending or 0) > 0 then
		M.sms_pending = M.sms_pending - 1
	end
	M.publish()
	reply(cli, { ok = true, index = idx, state = state, unread = (S.sms or {}).unread })
end

--- A long message occupies several slots, so the UI passes back the whole `indexes`
--- list it got from sms_list rather than one index at a time.
function API.sms_delete(cli, args)
	local wanted = {}
	if type(args.indexes) == "table" then
		for _, v in ipairs(args.indexes) do
			local n = tonumber(v)
			if n then wanted[#wanted + 1] = n end
		end
	end
	local one = tonumber(args.index)
	if one then wanted[#wanted + 1] = one end
	if #wanted == 0 then return reply(cli, { error = "index required" }) end
	if #wanted > 16 then return reply(cli, { error = "too many messages at once" }) end

	local steps = {}
	for _, n in ipairs(wanted) do
		steps[#steps + 1] = { cmd = "AT+CMGD=" .. n, timeout = 25, tolerate = true }
	end
	steps[#steps + 1] = { cmd = "AT+CPMS?", parse = M.parsers.cpms, tolerate = true }
	run_for(cli, "sms_delete", steps, function(ok, _, err)
		if ok then
			for _, n in ipairs(wanted) do SMS.forget(n) end
			M.publish()
		end
		return { ok = ok, error = err, deleted = wanted }
	end)
end

--- AT+CMGD=1,4 wipes the store regardless of the index given.
function API.sms_delete_all(cli, args)
	run_for(cli, "sms_delete_all", {
		{ cmd = "AT+CMGD=1,4", timeout = 60 },
		{ cmd = "AT+CPMS?", parse = M.parsers.cpms, tolerate = true },
	}, function(ok, _, err)
		if ok then
			SMS.seen = {}
			SMS.loaded = true
			SMS.save()
			M.sms_pending = 0
			M.publish()
		end
		return { ok = ok, error = err }
	end)
end

--- Message settings the user can actually change: the service centre number.
function API.sms_settings(cli)
	local raw = {}
	run_for(cli, "sms_settings", {
		{ cmd = "AT+CSCA?", parse = M.parsers.csca, tolerate = true },
		{ cmd = "AT+CPMS?", parse = M.parsers.cpms, tolerate = true },
		{ cmd = "AT+CSMP?", tolerate = true,
		  parse = function(l) raw.csmp = trim(table.concat(l, " ")) end },
	}, function(ok, _, err)
		return { ok = ok, error = err, sms = S.sms or {}, csmp = raw.csmp }
	end)
end

function API.sms_settings_set(cli, args)
	local sca = tostring(args.sca or "")
	if not sca:match("^%+?%d[%d]*$") then
		return reply(cli, { error = "invalid service centre number" })
	end
	run_for(cli, "sms_settings_set", {
		{ cmd = ('AT+CSCA="%s",%d'):format(sca, sca:sub(1, 1) == "+" and 145 or 129),
		  timeout = 25 },
		{ cmd = "AT+CSCA?", parse = M.parsers.csca, tolerate = true },
	}, function(ok, _, err)
		M.publish()
		return { ok = ok, error = err, sca = (S.sms or {}).sca }
	end)
end

--- Send (or, with save=true, only store) a message.  Non-Latin text needs UCS2, and
--- in UCS2 character set the destination number must be hex-encoded as well.
local function sms_write(cli, args, save)
	local to, text = tostring(args.to or ""), tostring(args.text or "")
	if to == "" then return reply(cli, { error = "no destination" }) end
	if text == "" then return reply(cli, { error = "empty text" }) end
	local ascii = is_ascii(text)
	local addr, body = to, text
	local steps = { { cmd = "AT+CMGF=1", tolerate = true } }
	if ascii then
		steps[#steps + 1] = { cmd = 'AT+CSCS="GSM"', tolerate = true }
		steps[#steps + 1] = { cmd = "AT+CSMP=17,167,0,0", tolerate = true }
	else
		steps[#steps + 1] = { cmd = 'AT+CSCS="UCS2"', tolerate = true }
		steps[#steps + 1] = { cmd = "AT+CSMP=17,167,0,8", tolerate = true }
		addr = utf8_to_ucs2(to)
		body = utf8_to_ucs2(text)
	end
	local sent = {}
	steps[#steps + 1] = { cmd = ('AT+%s="%s"'):format(save and "CMGW" or "CMGS", addr),
	                      term = "prompt", timeout = 20 }
	steps[#steps + 1] = { cmd = body .. "\26", term = "raw_bytes", timeout = 90,
	                      parse = function(lines)
		for _, l in ipairs(lines) do
			local ref = l:match("^%+CMG[SW]:%s*(%d+)")
			if ref then sent.ref = tonumber(ref) end
		end
	end }
	steps[#steps + 1] = { cmd = 'AT+CSCS="IRA"', tolerate = true }
	run_for(cli, save and "sms_save" or "sms_send", steps, function(ok, _, err)
		return { ok = ok, error = err, reference = sent.ref, ucs2 = not ascii }
	end)
end

function API.sms_send(cli, args) sms_write(cli, args, false) end
function API.sms_save(cli, args) sms_write(cli, args, true)  end

function API.apn_list(cli)
	run_for(cli, "apn_list", {
		{ cmd = "AT+CGDCONT?", parse = M.parsers.cgdcont, tolerate = true },
	}, function(ok, _, err)
		return { ok = ok, error = err, count = (S.apn and S.apn.count) or 0,
		         list = (S.apn and S.apn.list) or {} }
	end)
end

local PDP_TYPES = { IP = true, IPV6 = true, IPV4V6 = true, PPP = true }

--- Define or edit a profile.  Credentials do not live in +CGDCONT on this firmware --
--- +CGAUTH answers ERROR -- so they go through Qualcomm's $QCPDPP, whose argument
--- order is (cid, auth type, password, username).
function API.apn_set(cli, args)
	local cid = tonumber(args.cid) or 1
	local apn = tostring(args.apn or "")
	local pdp = tostring(args.pdp_type or "IPV4V6"):upper()
	if cid < 1 or cid > 24 then return reply(cli, { error = "cid out of range" }) end
	if apn:find('[",\r\n]') then return reply(cli, { error = "invalid APN" }) end
	if not PDP_TYPES[pdp] then return reply(cli, { error = "invalid PDP type" }) end

	local steps = {
		{ cmd = ('AT+CGDCONT=%d,"%s","%s"'):format(cid, pdp, apn), timeout = 25 },
	}
	if args.auth ~= nil or args.user ~= nil or args.pass ~= nil then
		local user, pass = tostring(args.user or ""), tostring(args.pass or "")
		if user:find('[",\r\n]') or pass:find('[",\r\n]') then
			return reply(cli, { error = "invalid credentials" })
		end
		local a = tonumber(args.auth)
		if not a then a = (user ~= "") and 3 or 0 end
		if a < 0 or a > 3 then return reply(cli, { error = "invalid auth type" }) end
		steps[#steps + 1] = (a == 0)
			and { cmd = ("AT$QCPDPP=%d,0"):format(cid), tolerate = true, timeout = 25 }
			or  { cmd = ('AT$QCPDPP=%d,%d,"%s","%s"'):format(cid, a, pass, user),
			      tolerate = true, timeout = 25 }
	end
	steps[#steps + 1] = { cmd = "AT$QCPDPP?",  parse = M.parsers.qcpdpp,  tolerate = true }
	steps[#steps + 1] = { cmd = "AT+CGDCONT?", parse = M.parsers.cgdcont, tolerate = true }

	run_for(cli, "apn_set", steps, function(ok, _, err)
		M.publish()
		return { ok = ok, error = err, list = (S.apn and S.apn.list) or {} }
	end)
end

function API.apn_delete(cli, args)
	local cid = tonumber(args.cid)
	if not cid then return reply(cli, { error = "cid required" }) end
	run_for(cli, "apn_delete", {
		{ cmd = "AT+CGDCONT=" .. cid, timeout = 25 },
		{ cmd = "AT+CGDCONT?", parse = M.parsers.cgdcont, tolerate = true },
	})
end

